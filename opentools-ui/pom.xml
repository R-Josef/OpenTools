<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.opentools</groupId>
        <artifactId>opentools-parent</artifactId>
        <version>0.13.6-SNAPSHOT</version>
    </parent>

    <artifactId>opentools-ui</artifactId>
    <name>OpenTools Swing UI</name>

    <dependencies>
        <dependency>
            <groupId>io.opentools</groupId>
            <artifactId>opentools-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentools</groupId>
            <artifactId>opentools-formats</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentools</groupId>
            <artifactId>opentools-analysis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentools</groupId>
            <artifactId>opentools-visualization</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentools</groupId>
            <artifactId>opentools-external</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentools</groupId>
            <artifactId>opentools-plugin-host</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}/../docs</directory>
                <targetPath>docs</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>
</project>
